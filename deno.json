{
  "name": "@zimme/bunny-hole",
  "version": "1.0.0-rc.5",
  "exports": "./apps/connector/mod.ts",
  "license": "MIT",
  "publish": {
    "include": [
      "LICENSE",
      "README.md",
      "apps/connector/client.ts",
      "apps/connector/frpc_config.ts",
      "apps/connector/library.ts",
      "apps/connector/mod.ts",
      "packages/api",
      "apps/connector/origin_bridge.ts"
    ]
  },
  "workspace": [
    "fixtures/origin"
  ],
  "lock": {
    "path": "./deno.lock",
    "frozen": true
  },
  "imports": {
    "@simplewebauthn/server": "npm:@simplewebauthn/server@13.3.2",
    "cspell": "npm:cspell@10.3.0"
  },
  "tasks": {
    "setup": "deno ci && deno install --config deno.runtime.json --frozen && deno task hooks:install",
    "agents:check": "deno run --allow-read=. scripts/verify_agents.ts",
    "workflows:check": "deno run --allow-env=LOG_STREAM,LOG_TOKENS --allow-read=. scripts/workflows_check.ts",
    "deployment-template:check": "deno run --allow-env=LOG_STREAM,LOG_TOKENS --allow-read=. scripts/deployment_template_check.ts",
    "deployment-template:guards": "python3 templates/bunny-deployment/scripts/test_workflows.py",
    "deployment:scaffold": "deno run --allow-read=. --allow-write scripts/scaffold_deployment.ts",
    "deployment-template:terraform": "deno run --allow-env --allow-net=registry.terraform.io,releases.hashicorp.com --allow-read=templates/bunny-deployment --allow-run=terraform --allow-write=/tmp scripts/terraform_template_validate.ts",
    "version:bump": "deno run --allow-read=deno.json,packages/api/mod.ts,docs/openapi.yaml --allow-write=deno.json,packages/api/mod.ts,docs/openapi.yaml scripts/version_bump.ts",
    "version:check": "deno run --allow-read=. scripts/version_check.ts",
    "package:check": "deno run --allow-env --allow-net=127.0.0.1 --allow-read=.,/tmp --allow-run=deno,npm,node,tar --allow-write=/tmp scripts/verify_package.ts",
    "package:build": "deno run --allow-read=.,/tmp --allow-run=deno,npm,tar --allow-write=dist,/tmp scripts/build_npm_package.ts",
    "release:check": "deno run --allow-read=. --allow-run=git scripts/release_check.ts",
    "release:artifacts": "deno run --allow-net=github.com,objects.githubusercontent.com,release-assets.githubusercontent.com,curl.se,www.mozilla.org --allow-read=. --allow-write=dist --allow-run=deno,tar,unzip scripts/build_release_artifacts.ts",
    "release:deployment-template": "deno run --allow-env=RELEASE_TAG,RELEASE_COMMIT,RELEASE_REPOSITORY,HOST_DIGEST,CONNECTOR_DIGEST,LOG_STREAM,LOG_TOKENS --allow-read=.,/tmp --allow-write=dist,/tmp --allow-run=tar scripts/build_deployment_archive.ts",
    "release:publish-package": "deno run --allow-env=RELEASE_TAG,ACTIONS_ID_TOKEN_REQUEST_URL,ACTIONS_ID_TOKEN_REQUEST_TOKEN,GITHUB_ACTIONS,GITHUB_EVENT_NAME,GITHUB_REF,GITHUB_REPOSITORY,GITHUB_REPOSITORY_ID,GITHUB_REPOSITORY_OWNER_ID,GITHUB_RUN_ATTEMPT,GITHUB_RUN_ID,GITHUB_SERVER_URL,GITHUB_SHA,GITHUB_WORKFLOW_REF,RUNNER_ENVIRONMENT --allow-net=jsr.io --allow-read=. --allow-run=deno scripts/publish_package.ts",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "spellcheck": "deno run --allow-env --allow-sys=homedir,uid --allow-read cspell lint --config cspell.json --gitignore --dot --no-progress .",
    "lint": "deno lint",
    "check": "deno check apps/compose/main.ts apps/host/main.ts apps/connector/main.ts apps/connector/mod.ts fixtures/origin/main.ts fixtures/tls_gateway/main.ts scripts/*.ts tests/*.ts",
    "docs:check": "deno run --allow-read=. --allow-run=deno scripts/docs_check.ts",
    "test": "deno test --allow-env --allow-net --allow-read --allow-run --allow-write --coverage=coverage --clean tests",
    "coverage": "deno run --allow-read=. --allow-write=coverage --allow-run=deno scripts/coverage_check.ts",
    "integration": "deno run --allow-env --allow-net --allow-read=. --allow-run=docker,openssl --allow-sys=uid,gid --allow-write=.tmp scripts/integration.ts",
    "build": "deno run --allow-read=. --allow-write=dist --allow-run=deno scripts/build.ts",
    "container:build": "docker build --target host-runtime -t bunny-hole-host:local . && docker build --target connector-runtime -t bunny-hole-connector:local .",
    "container:smoke": "deno run --allow-env --allow-net --allow-run=docker scripts/container_smoke.ts",
    "audit": "deno audit",
    "secrets:check": "deno run --allow-read=. --allow-run=git scripts/secret_scan.ts",
    "licenses:check": "deno run --allow-read=. scripts/license_check.ts",
    "generated:check": "deno run --allow-read=. --allow-run=git scripts/generated_check.ts",
    "commits:check": "deno run --allow-run=git scripts/commit_check.ts",
    "hooks:install": "deno run --allow-run=git scripts/install_hooks.ts",
    "validate": "deno run --allow-env --allow-net --allow-read=. --allow-run=deno,docker,git,terraform --allow-write=coverage,dist,/tmp scripts/validate.ts",
    "devcontainer:up": "sh .devcontainer/initialize.sh && docker compose up --build --detach development",
    "devcontainer:exec": "deno run --allow-run=docker scripts/development_exec.ts",
    "devcontainer:down": "docker compose down",
    "correctness:check": "deno run --allow-env --allow-read=. --allow-write=/tmp --allow-run=deno scripts/correctness_check.ts"
  },
  "fmt": {
    "lineWidth": 88,
    "proseWrap": "always",
    "exclude": [
      "coverage",
      "dist"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "ban-untagged-todo"
      ]
    },
    "exclude": [
      "coverage",
      "dist"
    ]
  },
  "test": {
    "include": [
      "tests"
    ]
  },
  "compilerOptions": {
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  }
}
