{
  "workspace": [
    "packages/protocol",
    "apps/relay",
    "apps/connector",
    "fixtures/origin"
  ],
  "lock": {
    "path": "./deno.lock",
    "frozen": true
  },
  "imports": {
    "cspell": "npm:cspell@9.2.1"
  },
  "tasks": {
    "setup": "deno ci && deno task hooks:install",
    "agents:check": "deno run --allow-read=. scripts/verify_agents.ts",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "spellcheck": "deno run --allow-env --allow-sys=homedir --allow-read cspell lint --config cspell.json --gitignore --dot --no-progress .",
    "lint": "deno lint",
    "check": "deno check apps/relay/main.ts apps/connector/main.ts fixtures/origin/main.ts scripts/*.ts tests/*.ts",
    "docs:check": "deno run --allow-read=. --allow-run=deno scripts/docs_check.ts",
    "test": "deno cache --reload apps/relay/relay.ts apps/connector/connector.ts packages/protocol/mod.ts && deno test --allow-env --allow-net --allow-read --coverage=coverage --clean --coverage-raw-data-only tests",
    "coverage": "deno coverage coverage --threshold=70",
    "integration": "deno run --allow-env --allow-net --allow-read=. --allow-run=docker --allow-write=/tmp scripts/integration.ts",
    "build": "deno run --allow-read=. --allow-write=dist --allow-run=deno scripts/build.ts",
    "container:build": "docker build --target relay-runtime -t bunny-hole-relay:local .",
    "container:smoke": "deno run --allow-env --allow-net --allow-run=docker scripts/container_smoke.ts",
    "audit": "deno audit",
    "secrets:check": "deno run --allow-read=. --allow-run=git scripts/secret_scan.ts",
    "licenses:check": "deno run --allow-read=. scripts/license_check.ts",
    "generated:check": "deno run --allow-read=. --allow-run=git scripts/generated_check.ts",
    "commits:check": "deno run --allow-run=git scripts/commit_check.ts",
    "hooks:install": "deno run --allow-run=git scripts/install_hooks.ts",
    "validate": "deno run --allow-env --allow-net --allow-read=. --allow-run=deno,docker,git --allow-write=coverage,dist,/tmp scripts/validate.ts",
    "devcontainer:up": "deno run -A --no-config --no-lock npm:@devcontainers/cli@0.87.0 up --workspace-folder . --frozen-lockfile",
    "devcontainer:exec": "deno run -A --no-config --no-lock npm:@devcontainers/cli@0.87.0 exec --workspace-folder .",
    "devcontainer:down": "docker compose -f .devcontainer/compose.yaml down"
  },
  "fmt": {
    "lineWidth": 88,
    "proseWrap": "always",
    "exclude": ["coverage", "dist"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": ["ban-untagged-todo"]
    },
    "exclude": ["coverage", "dist"]
  },
  "test": {
    "include": ["tests"]
  }
}
